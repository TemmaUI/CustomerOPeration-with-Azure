@model IEnumerable<AzureCustomerOPeration.Models.LeadEntity>
@{
    ViewData["Title"] = "Index";
}

<h1>Customer Information Platform</h1>

<p>
    <a asp-action="CreateCustomer" asp-controller="AccountProfile">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Phone)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Address)
                </td>
                <td>
                    <a asp-action="UpdateCustomer" asp-route-id="@item.Id" asp-controller="AccountProfile">Edit</a> |
                    <a asp-action="CustomerDetails" asp-route-id="@item.Id" asp-controller="AccountProfile">Details</a> |
                    <a asp-action="DeleteCustomer" asp-route-id="@item.Id" asp-controller="AccountProfile">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
``)
